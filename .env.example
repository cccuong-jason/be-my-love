# ============================================================
# Be My Love - Environment Variables
# ============================================================
# Copy this file to .env.local for local development
# For Vercel: Add these in Project Settings > Environment Variables
# ============================================================

# --- MongoDB Atlas ---
# For Vercel deployment, use a MongoDB Atlas connection string
# Local Docker: mongodb://mongo:27017/be-my-love
# Atlas:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net/be-my-love?retryWrites=true&w=majority
MONGODB_URI=

# --- Clerk Authentication ---
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- S3-Compatible Storage (CloudFly) ---
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=
AWS_S3_ENDPOINT=https://s3.cloudfly.vn
